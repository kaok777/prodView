# Frontend Environment Variables

# API Configuration
# URL of the backend API server (must include /api prefix)
# Development: http://localhost:3000/api
# Production: https://your-api-domain.com/api
VITE_API_URL=http://localhost:3000/api

# Optional: Analytics Configuration
# Add your analytics tracking ID if using Google Analytics, etc.
# VITE_ANALYTICS_ID=your-analytics-id

# Optional: Feature Flags
# VITE_ENABLE_DARK_MODE=true

# Development Tools
# Enable Chef.dev integration for development screenshots (default: false)
# Fixed: LOW-F4 - Feature-flagged Chef injection
# ENABLE_CHEF=true
