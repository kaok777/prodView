# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:admin@localhost:5432/prodview?schema=public"

# JWT Configuration
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION
# Must be at least 32 characters for security
# Generate with: openssl rand -base64 48
# NEVER use this example value in production!
JWT_SECRET="CHANGE_THIS_GENERATE_SECRET_WITH_openssl_rand_base64_48"
# Access token expiration (short-lived) - recommended: 15m
# Refresh token expiration is hardcoded to 7d
JWT_EXPIRATION="15m"

# Server Configuration
# Port for the API server
PORT=3000
# Node environment (development, production, test)
NODE_ENV=development

# CORS Configuration
# Allowed origins for CORS (comma-separated for multiple origins)
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGIN="http://localhost:5173"
# CORS preflight cache max age in seconds (default 86400 = 24 hours)
# Fixed: LOW-B1 - Increased from 600s to 86400s for better performance
CORS_MAX_AGE=86400

# File Upload Configuration
# Directory for uploaded files (relative to backend root)
UPLOAD_DIR="./uploads"
# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=".jpg,.jpeg,.png,.gif,.webp"

# Request Body Size Limits
# Maximum JSON request body size in bytes
# Recommendation: 1MB for API requests (1048576 bytes)
# Note: File uploads use separate multer limits (see MAX_FILE_SIZE)
MAX_BODY_SIZE=1048576

# Rate Limiting Configuration
# Time-to-live for rate limit window in seconds
RATE_LIMIT_TTL=60
# Maximum requests per TTL window
RATE_LIMIT_MAX=100

# Admin Configuration (for initialization script)
# These credentials are used ONLY by the create-admin script
# DO NOT hardcode in application code - use npm run create-admin
# Password requirements: min 8 chars, uppercase, lowercase, number, special char
ADMIN_EMAIL="CHANGE_THIS_admin@yourdomain.com"
ADMIN_PASSWORD="CHANGE_THIS_STRONG_PASSWORD_min_8_chars"

# Optional: Logging Configuration
# Log level (error, warn, info, debug, verbose)
LOG_LEVEL="info"
