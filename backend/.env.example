# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:admin@localhost:5432/prodview?schema=public"

# JWT Configuration
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION
JWT_SECRET="your-super-secure-jwt-secret-change-this-in-production-min-32-chars"
# Token expiration time (e.g., "24h", "7d", "30d")
JWT_EXPIRATION="24h"

# Server Configuration
# Port for the API server
PORT=3000
# Node environment (development, production, test)
NODE_ENV=development

# CORS Configuration
# Allowed origins for CORS (comma-separated for multiple origins)
# Example: http://localhost:5173,https://yourdomain.com
CORS_ORIGIN="http://localhost:5173"

# File Upload Configuration
# Directory for uploaded files (relative to backend root)
UPLOAD_DIR="./uploads"
# Maximum file size in bytes (10MB = 10485760)
MAX_FILE_SIZE=10485760
# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=".jpg,.jpeg,.png,.gif,.webp"

# Rate Limiting Configuration
# Time-to-live for rate limit window in seconds
RATE_LIMIT_TTL=60
# Maximum requests per TTL window
RATE_LIMIT_MAX=100

# Admin Configuration (for seeding)
# Default admin credentials - CHANGE THESE IMMEDIATELY
ADMIN_EMAIL="vibrationconnect@gmail.com"
ADMIN_PASSWORD="Cxserfd345!"
ADMIN_NAME="Admin User"

# Optional: Logging Configuration
# Log level (error, warn, info, debug, verbose)
LOG_LEVEL="info"
